# Copy to .env (never commit .env). Placeholders only.
PORT=3000
# Secret used to hash license keys at rest and to protect admin routes. Generate: openssl rand -hex 32
LICENSE_HASH_SECRET=replace-me
ADMIN_TOKEN=replace-me
# Stripe: leave blank for stub mode (no network calls).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PRO=
# Live checkout needs BOTH a key and this explicit owner approval flag.
LIVE_PAYMENTS_APPROVED=no
PUBLIC_BASE_URL=http://localhost:3000
# Rate limit: max requests per window per client
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
# Placeholder price shown on pricing page (needs owner approval)
PRO_PRICE_USD=12
